# Environment configuration untuk Monitoring Mobil Kantor
# Salin file ini menjadi .env dan isi dengan nilai sebenarnya.
# JANGAN commit file .env ke Git.

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitoring_mobil_kantor
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sucofindofirst.rf.gd
